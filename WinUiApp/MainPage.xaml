<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinUiApp.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WinUiApp"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        This is the main content area of your application.
        Add your UI elements here — for example, controls, layouts, and data-bound views.
        Use 'dotnet new winui-page' to create additional pages and navigate to them via
        the Frame in MainWindow (RootFrame).
    -->
    <Grid Padding="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="8">
            <TextBlock Text="Available devices" FontSize="28" FontWeight="SemiBold" />
            <TextBlock x:Name="StatusText" Text="Searching on this Wi-Fi network..." Opacity="0.7" />
        </StackPanel>
        <StackPanel x:Name="DevicePanel" Grid.Row="1" Spacing="10" Margin="0,24,0,0" />
    </Grid>
</Page>
